# ============================================================================
# Smart Contact Manager (SCM) Microservices - Twelve-Factor Configuration
# ============================================================================

SPRING_APPLICATION_NAME=scm

# --- Edge Gateway & Ports ---
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
CONTACT_SERVICE_PORT=8082
MEDIA_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
AUDIT_SERVICE_PORT=8085
INTEGRATION_SERVICE_PORT=8086
FRONTEND_PORT=3000

# --- Downstream Service URLs ---
AUTH_SERVICE_URL=http://localhost:8081
CONTACT_SERVICE_URL=http://localhost:8082
MEDIA_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084
AUDIT_SERVICE_URL=http://localhost:8085
INTEGRATION_SERVICE_URL=http://localhost:8086

# --- Relational Database (Aiven Cloud MySQL 8.0 + Local SCM MySQL) ---
DB_HOST=auth-contact-api-gateway-example.aivencloud.com
DB_PORT=14049
DB_NAME=defaultdb
DB_SSL_MODE=REQUIRED
DB_SERVICE_URI=mysql://avnadmin:your_aiven_password@auth-contact-api-gateway-example.aivencloud.com:14049/defaultdb?ssl-mode=REQUIRED
DB_URL=jdbc:mysql://auth-contact-api-gateway-example.aivencloud.com:14049/defaultdb?sslMode=REQUIRED&useSSL=true&requireSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_DRIVER=com.mysql.cj.jdbc.Driver
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# --- Local MySQL 8.0 Fallback ---
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=scm
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=your_local_mysql_password_here

# --- NoSQL Document Store (MongoDB Atlas 7.0) ---
MONGO_HOST=cluster0.example.mongodb.net
MONGO_USERNAME=scm_db_user
MONGO_PASSWORD=your_mongo_password_here
MONGO_DB=scm_audit_store
MONGODB_URI=mongodb+srv://scm_db_user:your_mongo_password@cluster0.example.mongodb.net/scm_audit_store?retryWrites=true&w=majority

# --- Stateless JWT & OAuth2 Security (Google & GitHub) ---
JWT_SECRET=your_jwt_secret_signing_key_here
JWT_EXPIRATION_MS=86400000
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_SCOPE=openid,profile,email
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/oauth2/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_SCOPE=read:user,user:email
GITHUB_REDIRECT_URI=http://localhost:8080/v1/auth/oauth2/github/callback

# --- Notification Service (Gmail SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_FROM=your_gmail_address@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# --- Multipart Contact Picture Uploads ---
MULTIPART_MAX_FILE_SIZE=2MB
MULTIPART_MAX_REQUEST_SIZE=3MB
MEDIA_MAX_FILE_SIZE_BYTES=2097152
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# --- CORS, Rate Limiting & Resilience ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
OUTBOUND_TIMEOUT_MS=3000
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=100
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000
